    usecase "View Public Dashboard" as UC7
    usecase "Review Pending Incidents" as UC8
    usecase "Approve / Reject Incident" as UC9
    usecase "Manage Users" as UC10
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
Analyst --> UC8
Analyst --> UC9
